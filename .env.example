#Create a new .env file based on this example and fill in the required values.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# PostgreSQL Database
POSTGRES_DB=uploader_db
POSTGRES_USER=uploader_user
POSTGRES_PASSWORD=supersecret
DB_HOST=db
DB_PORT=5432

# MinIO/S3 Settings
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=my-local-bucket
AWS_S3_USE_SSL=False

# OIDC Settings
OIDC_RP_CLIENT_ID=your_oidc_client_id
OIDC_RP_CLIENT_SECRET=your_oidc_client_secret
OIDC_OP_AUTHORIZATION_ENDPOINT=https://your-provider.com/auth
OIDC_OP_TOKEN_ENDPOINT=https://your-provider.com/token
OIDC_OP_USER_ENDPOINT=https://your-provider.com/userinfo

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password